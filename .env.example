# ─── App URLs (change these on deploy) ────────────────────
# URL of the backend API. Leave empty in dev (Vite proxy /api -> backend).
# Set the full API base in production, e.g. https://api.yourdomain.com
VITE_API_URL=

# URL of the admin panel (used by the "Admin Panel" button on the dashboard)
VITE_ADMIN_URL=http://localhost:5174
